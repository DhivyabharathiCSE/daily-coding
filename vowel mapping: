	
Given the following vowel mapping:

a → 2
e → 3
i → 4
o → 5
u → 6

Replace each vowel in the given string with its corresponding number.

Example:

Input:
Harish

Output:
H2r4sh



  #include<iostream>
  using namespace std;
int main()
{
  string s;
getline(cin,s);
for(int i=0;i<s.length();i++)
{
if(s[i]=='a')
{
cout<<"2";
}
else if(s[i]=='e'){
cout<<"3";
}
else if(s[i]=='i'){
cout<<"4";
}
else if(s[i]=='o'){
cout<<"5";
}
else if(s[i]=='u'){
cout<<"6";
}
 else {
            cout << s[i]; }
}
}
